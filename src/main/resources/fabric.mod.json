{
  "schemaVersion": 1,
  "id": "damagetint",
  "version": "${version}",
  "name": "Damage tint",
  "description": "Adds a red tint on the player's screen when they're low on health.",
  "authors": [
    "MossFET",
    "DeadlyMC"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/damage-tint",
    "sources": "https://github.com/mossssfet/damage-tint/",
    "issues": "https://github.com/mossssfet/damage-tint/issues"
  },
  "license": "MIT",
  "icon": "assets/damagetint/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "me.mossfet.damagetint.DamageTint"
    ]
  },
  "mixins": [
    {
      "config": "damagetint.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}
